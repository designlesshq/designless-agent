{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}\"/bin/designless hook session-start-inbox"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}\"/bin/designless hook canvas-wake"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}\"/bin/designless hook canvas-drain-check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*less_.*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}\"/bin/designless hook canvas-arm-watch"
          }
        ]
      },
      {
        "matcher": ".*less_canvas_compose$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}\"/bin/designless hook compose-epilogue"
          }
        ]
      }
    ]
  }
}
