{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "/bin/sh ./bin/designless hook session-start-inbox"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "/bin/sh ./bin/designless hook canvas-wake"
      }
    ],
    "stop": [
      {
        "command": "/bin/sh ./bin/designless hook canvas-drain-check",
        "loop_limit": 3
      }
    ],
    "afterMCPExecution": [
      {
        "command": "/bin/sh ./bin/designless hook compose-epilogue"
      }
    ]
  }
}
